# LLM 配置参数
MODEL_PROVIDER=openai
MODEL_NAME=qwen-plus
API_KEY=
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# LangGraph Auth 配置参数
DEMO_USER_TOKEN=
DEMO_USER_ID=
DEMO_USER_PASSWORD=
DEMO_USER_EXTERNAL_ID=


# 微信体系
WXWORK_CORP_ID=
WXWORK_APP_ID=
WXWORK_APP_SECRET=


## 停止Trace
LANGSMITH_TRACING=false
LOG_LEVEL=WARNING

## LangSmith 参数
LANGSMITH_PROJECT=sagt-agent
LANGSMITH_API_KEY=


# standalone 方式部署
# DATABASE_URI=postgresql://user:password@host:port/db
# REDIS_URI=redis://user:password@host:port/db

## docker compose 方式部署
# IMAGE_NAME=sagt:v2.2.1
# DOCKER_VOLUME_DIRECTORY=/docker_data_volume/sagt_data

## Langfuse
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL={LANGFUSE_BASE_URL}
